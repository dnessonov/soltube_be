{
  "name": "api1",
  "version": "1.0.0",
  "description": "This project was bootstrapped with Fastify-CLI.",
  "main": "app.ts",
  "imports": {
    "@/lib/*": "./dist/lib/*"
  },
  "directories": {
    "test": "test"
  },
  "scripts": {
    "test": "npm run build:ts && tsc -p test/tsconfig.json && c8 node --test -r ts-node/register \"test/**/*.ts\"",
    "start": "npm run build:ts && fastify start -l info dist/app.js",
    "build:ts": "tsc && npx tsc-alias",
    "watch:ts": "tsc -w & npx tsc-alias -w",
    "dev": "npm run build:ts && concurrently -k -p \"[{name}]\" -n \"TypeScript,App\" -c \"yellow.bold,cyan.bold\" \"npm:watch:ts\" \"npm:dev:start\"",
    "dev:start": "fastify start --ignore-watch=.ts$ -w -l info -P --ignore-watch='tmp' dist/app.js",
    "dev:worker": "npm run build:ts && concurrently -k -p \"[{name}]\" -n \"TypeScript,App\" -c \"yellow.bold,cyan.bold\" \"npm:watch:ts\" \"npm:dev:worker:start\"",
    "dev:worker:start": "PORT=3002 IS_WORKER=true fastify start --ignore-watch=.ts$ -w -l info -p 0 -P --ignore-watch='tmp' dist/app.js -- --worker_process"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@fastify/autoload": "^6.3.1",
    "@fastify/cors": "^11.2.0",
    "@fastify/env": "^6.0.0",
    "@fastify/formbody": "^8.0.2",
    "@fastify/multipart": "^10.0.0",
    "@fastify/postgres": "^6.0.2",
    "@fastify/redis": "^7.2.0",
    "@fastify/sensible": "^6.0.0",
    "@fastify/websocket": "^11.2.0",
    "@sinclair/typebox": "^0.34.49",
    "@solana/web3.js": "^1.98.4",
    "dotenv": "^17.4.2",
    "fastify": "^5.0.0",
    "fastify-cli": "^8.0.0",
    "fastify-plugin": "^5.0.0",
    "fluent-ffmpeg": "^2.1.3",
    "ioredis": "^5.11.0",
    "pg": "^8.21.0",
    "tweetnacl": "^1.0.3"
  },
  "devDependencies": {
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/node": "^25.9.1",
    "c8": "^11.0.0",
    "concurrently": "^9.0.0",
    "fastify-tsconfig": "^3.0.0",
    "ts-node": "^10.4.0",
    "tsc-alias": "^1.8.17",
    "typescript": "~5.9.2"
  }
}
